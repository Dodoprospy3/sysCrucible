#!/usr/bin/env bash
set -euo pipefail

cd "$HOME" || exit

sudo pacman -Syu --noconfirm

sudo pacman -S base-devel git --needed --noconfirm
sudo pacman -S curl wget --needed --noconfirm
sudo pacman -S figlet lolcat --needed --noconfirm
sudo pacman -S rog-control-center --needed --noconfirm
sudo pacman -S zoxide zsh neovim --needed --noconfirm
sudo pacman -S hyprland waybar --needed --noconfirm

chsh -s "$(command -v zsh)"
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

if ! command -v paru &>/dev/null; then
    echo "paru is not installed."
    git clone https://aur.archlinux.org/paru.git
    cd paru || exit
    makepkg -si
    echo "paru installed successfully!" | figlet | lolcat
    cd "$HOME" || exit
fi

if ! command -v yay &>/dev/null; then
    echo "yay is not installed."
    git clone https://aur.archlinux.org/yay.git
    cd yay || exit
    makepkg -si
    echo "yay installed successfully!" | figlet | lolcat
    cd "$HOME" || exit
fi

cd "$HOME" || exit
paru -Syu --noconfirm

paru -S linutil --needed --noconfirm


cd "$HOME"/.config 
mkdir -p nvim/
cd nvim/
git clone https://github.com/Dodoprospy3/nvimrc .


cd "$HOME"/.config 
mkdir -p hypr/
cd hypr/
git clone https://github.com/Dodoprospy3/hyprdots .


